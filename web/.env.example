# Supabase — copy to .env.local and fill in from
# Supabase dashboard -> Project Settings -> API (also set these on Vercel).
# The anon/publishable key is safe to expose to browsers; row-level security
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
